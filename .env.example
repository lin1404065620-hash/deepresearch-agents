# OpenAI-compatible model service
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.example.com/v1
LLM_QWEN3=replace-with-your-fast-model-name
LLM_QWEN_MAX=replace-with-your-capable-model-name

# Web search
TAVILY_API_KEY=replace-with-your-tavily-api-key

# RAGFlow
RAGFLOW_API_URL=https://ragflow.example.com
RAGFLOW_API_KEY=replace-with-your-ragflow-api-key
RAGFLOW_CHAT_NAME=replace-with-your-chat-name
RAGFLOW_TEST_QUESTION=replace-with-a-safe-test-question

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-database-user
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_DATABASE=replace-with-your-database-name
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
MYSQL_IMPORT_FILE=mysql/pharma_sales_records.xlsx

# Local runtime
RUNTIME_DEV_USER_ID=local-user
ENABLE_LEGACY_AGENT_API=false
ENABLE_LEGACY_PATH_API=false
CORS_ALLOW_ORIGINS=http://localhost:8000
